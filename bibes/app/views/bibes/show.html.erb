<% content_for :title, "#{@bibe.name} · BIBEs" %>

<div class="app-shell">
  <aside class="sidebar">
    <a class="wordmark" href="<%= root_path %>" aria-label="BIBEs home"><span class="wordmark-mark">b</span><span>bibes</span></a>
    <div class="sidebar-label">Workspace</div>
    <a class="nav-item" href="<%= root_path %>"><span class="nav-icon"><%= lucide_icon(:dashboard, size: 16) %></span>Environments</a>
    <div class="sidebar-bottom">
      <div class="cluster-card"><span class="cluster-dot dot-live"></span><div><strong><%= Kubernetes.current_context %></strong><small>Local Kubernetes</small></div></div>
      <div class="sidebar-footnote">A local BIBE experiment</div>
    </div>
  </aside>

  <main class="main-content">
    <header class="topbar">
      <div class="breadcrumb"><a href="<%= root_path %>">Environments</a><span class="crumb-slash">/</span><strong><%= @bibe.name %></strong></div>
      <div class="topbar-right"><span class="cluster-pill"><span class="cluster-dot <%= @cluster_ready ? 'dot-live' : 'dot-offline' %>"></span><%= @cluster_ready ? "Minikube connected" : "Minikube offline" %></span><span class="avatar"><%= @bibe.engineer.first&.upcase || "?" %></span></div>
    </header>

    <div class="page-wrap detail-wrap">
      <% if flash[:notice] %><div class="flash flash-notice" role="status"><span class="flash-check">✓</span><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="flash flash-alert" role="alert"><span>!</span><%= flash[:alert] %></div><% end %>

      <div class="detail-back"><a href="<%= root_path %>"><%= lucide_icon(:arrow_left, size: 14) %> All environments</a></div>
      <section class="detail-heading">
        <div>
          <div class="eyebrow"><span class="eyebrow-line"></span>ISOLATED BACKEND ENVIRONMENT</div>
          <div class="detail-title-row"><div class="detail-avatar"><%= @bibe.engineer.first&.upcase || "?" %></div><div><h1><%= @bibe.name %></h1><p><%= @bibe.engineer %>'s copy of <strong><%= @bibe.environment.capitalize %></strong></p></div></div>
        </div>
        <div class="detail-actions">
          <%= button_to "Reconcile parent", reconcile_bibe_path(@bibe), class: "button button-secondary", disabled: !@cluster_ready %>
          <details class="delete-details">
            <summary>Remove…</summary>
            <div class="delete-popover">
              <strong>Delete this BIBE?</strong>
              <p>This removes the <code><%= @bibe.namespace %></code> namespace and its workloads.</p>
              <%= button_to "Delete namespace", bibe_path(@bibe), method: :delete, class: "button button-small button-quiet", disabled: !@cluster_ready %>
            </div>
          </details>
        </div>
      </section>

      <section class="namespace-banner">
        <div><span class="namespace-icon"><%= lucide_icon(:boxes, size: 16) %></span><div><span class="banner-label">KUBERNETES NAMESPACE</span><code><%= @bibe.namespace %></code></div></div>
        <div class="namespace-health"><span class="cluster-dot <%= @cluster_ready ? 'dot-live' : 'dot-offline' %>"></span><%= @cluster_ready ? (@readiness.values.all? ? "All services ready" : "Waiting for pods") : "Cluster offline" %></div>
      </section>

      <section class="detail-summary">
        <div><span class="summary-label">PARENT ENVIRONMENT</span><strong><%= @parent.name.capitalize %></strong></div>
        <div><span class="summary-label">SERVICES</span><strong><%= @services.size %></strong></div>
        <div><span class="summary-label">FOLLOWING PARENT</span><strong><%= @bibe.syncing.size %></strong></div>
        <div><span class="summary-label">PINNED TO YOUR VERSION</span><strong><%= @bibe.pinned.size %></strong></div>
      </section>

      <section class="detail-services">
        <div class="section-heading">
          <div><div class="eyebrow">THIS BIBE</div><h2>Services</h2></div>
          <span class="section-count">One pod per service</span>
        </div>
        <div class="service-detail-list">
          <% @services.each do |bibe_service| %>
            <% parent_version = @parent.version_of(bibe_service.service) %>
            <article class="service-detail-row">
              <div class="service-detail-name"><span class="service-glyph service-glyph-large"><%= lucide_icon(bibe_service.service.kind == "store" ? :database : :boxes, size: 16) %></span><div><strong><%= bibe_service.service.name %></strong><span><%= bibe_service.service.dependencies.any? ? "Calls #{bibe_service.service.dependencies.join(', ')}" : "No service calls" %></span></div></div>
              <div class="detail-version"><span class="summary-label">RUNNING VERSION</span><code><%= bibe_service.version %></code><% if bibe_service.pinned? && parent_version != bibe_service.version %><small>Parent is on <%= parent_version %></small><% end %></div>
              <div class="detail-state"><span class="service-state <%= bibe_service.pinned? ? 'state-pinned' : 'state-sync' %>"><i></i><%= bibe_service.pinned? ? "Pinned" : "Following #{@parent.name}" %></span><small><%= !@cluster_ready ? "Cluster unavailable" : (@readiness[bibe_service.id] ? "Pod ready" : "Pod starting") %></small></div>
              <div class="service-deploy-control">
                <% if bibe_service.pinned? %>
                  <%= button_to "Follow parent", bibe_unpin_service_path(@bibe, bibe_service.service), class: "button button-small button-secondary", disabled: !@cluster_ready %>
                <% else %>
                  <%= form_with url: bibe_deploy_service_path(@bibe, bibe_service.service), method: :post, class: "pin-form" do |form| %>
                    <%= form.text_field :version, placeholder: "e.g. 2.5.0", aria: { label: "Version to deploy for #{bibe_service.service.name}" }, required: true, pattern: "[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?" %>
                    <%= form.submit "Deploy", class: "button button-small button-primary", disabled: !@cluster_ready %>
                  <% end %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      </section>

      <section class="detail-callout">
        <span class="callout-mark"><%= lucide_icon(:arrow_right, size: 16) %></span>
        <p><strong>Deploying pins one service.</strong> The other services keep following <%= @parent.name %>. Use “Follow parent” to unpin a service and bring it back in sync.</p>
      </section>

      <footer class="page-footer"><span><a href="<%= root_path %>"><%= lucide_icon(:arrow_left, size: 14) %> Back to all environments</a></span><span>Namespace isolation <b>·</b> Service-level deploys</span></footer>
    </div>
  </main>
</div>
