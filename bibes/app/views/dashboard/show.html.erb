<% content_for :title, "BIBEs · Local environments" %>

<div class="app-shell">
  <aside class="sidebar">
    <a class="wordmark" href="<%= root_path %>" aria-label="BIBEs home">
      <span class="wordmark-mark">b</span>
      <span>bibes</span>
    </a>

    <div class="sidebar-label">Workspace</div>
    <a class="nav-item nav-item-active" href="<%= root_path %>">
      <span class="nav-icon"><%= lucide_icon(:dashboard, size: 16) %></span>
      Environments
    </a>

    <div class="sidebar-bottom">
      <div class="cluster-card">
        <span class="cluster-dot <%= @cluster_ready ? 'dot-live' : 'dot-offline' %>"></span>
        <div>
          <strong><%= @cluster_ready ? @cluster_context : "Cluster offline" %></strong>
          <small><%= @cluster_ready ? "Local Kubernetes" : "Start Minikube to continue" %></small>
        </div>
      </div>
      <div class="sidebar-footnote">A local BIBE experiment</div>
    </div>
  </aside>

  <main class="main-content">
    <header class="topbar">
      <div class="breadcrumb"><span>Workspace</span><span class="crumb-slash">/</span><strong>Environments</strong></div>
      <div class="topbar-right">
        <span class="avatar">O</span>
      </div>
    </header>

    <div class="page-wrap">
      <% if flash[:notice] %><div class="flash flash-notice" role="status"><span class="flash-check">✓</span><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="flash flash-alert" role="alert"><span>!</span><%= flash[:alert] %></div><% end %>

      <% unless @cluster_ready %>
        <section class="cluster-warning">
          <div class="warning-symbol">!</div>
          <div>
            <strong>Minikube isn't responding</strong>
            <p>Start the local cluster, then refresh this page. <code>minikube start</code></p>
            <% if @cluster_error.present? %><small><%= @cluster_error %></small><% end %>
          </div>
        </section>
      <% end %>

      <section class="scenario-card" aria-labelledby="scenario-title">
        <div class="scenario-copy">
          <div class="eyebrow">STAGING RELEASE</div>
          <h1 id="scenario-title"><code>posts</code> <span><%= @demo_release.version %></span></h1>
          <%= form_with url: deploy_parent_service_path(@demo_environment, @demo_service), method: :post, class: "scenario-form" do |form| %>
            <label class="field-label" for="scenario_version">New version</label>
            <div class="scenario-form-row">
              <%= form.text_field :version, id: "scenario_version", value: @demo_next_version, required: true, pattern: "[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?", disabled: !@cluster_ready %>
              <%= form.submit "Release", class: "button button-primary", disabled: !@cluster_ready %>
            </div>
          <% end %>
        </div>
        <div class="scenario-results">
          <div class="scenario-results-heading"><span>ON RELEASE</span><span><%= @demo_copies.size %> <%= "BIBE".pluralize(@demo_copies.size) %></span></div>
          <% if @demo_copies.empty? %>
            <p class="scenario-empty">Create a staging BIBE to try this release.</p>
          <% else %>
            <% @demo_copies.each do |bibe, copy| %>
              <div class="scenario-copy-row">
                <div class="scenario-copy-identity"><span class="scenario-avatar"><%= bibe.engineer.first&.upcase || "?" %></span><strong><%= bibe.engineer %></strong></div>
                <% if copy.pinned? %>
                  <span class="scenario-effect effect-pinned"><i></i>Pinned at <code><%= copy.version %></code> · stays</span>
                <% else %>
                  <span class="scenario-effect effect-following"><i></i>Following staging · updates</span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

      <div class="section-heading">
        <div>
          <h2>Your BIBEs</h2>
        </div>
        <div class="section-actions">
          <span class="section-count"><%= @bibes.size %> <%= "BIBE".pluralize(@bibes.size) %></span>
          <a href="#create-bibe" class="button button-secondary button-small"><%= lucide_icon(:plus, size: 14) %> Create BIBE</a>
        </div>
      </div>

      <% if @bibes.empty? %>
        <section class="empty-state">
          <div class="empty-mark">b</div>
          <h3>Start with your first BIBE</h3>
          <p>Choose a parent environment. We'll create its services in a namespace of their own.</p>
          <a href="#create-bibe" class="button button-primary">Create a BIBE <span>→</span></a>
        </section>
      <% else %>
        <div class="bibe-grid">
          <% @bibes.each do |bibe| %>
            <% bibe_ready = @readiness[bibe.id] %>
            <% bibe_state = @cluster_ready ? (bibe_ready ? "READY" : "STARTING") : "OFFLINE" %>
            <article class="bibe-card">
              <div class="bibe-card-head">
                <div class="bibe-avatar"><%= bibe.engineer.first&.upcase || "?" %></div>
                <div class="bibe-identity">
                  <a class="bibe-name" href="<%= bibe_path(bibe) %>"><%= bibe.name %><span class="arrow"><%= lucide_icon(:arrow_up_right, size: 14) %></span></a>
                  <span class="bibe-owner"><%= bibe.engineer %> · from <%= bibe.environment %></span>
                </div>
                <span class="live-badge <%= @cluster_ready ? (bibe_ready ? 'badge-ready' : 'badge-starting') : 'badge-offline' %>"><i></i> <%= bibe_state %></span>
              </div>

              <div class="namespace-line"><span class="namespace-icon"><%= lucide_icon(:boxes, size: 15) %></span><code><%= bibe.namespace %></code><span class="namespace-scope">NAMESPACE</span></div>

              <% focus_copy = bibe.bibes_services.find { |copy| copy.service_id == @demo_service.id } %>
              <div class="focus-service">
                <div class="focus-service-name"><span class="service-glyph"><%= lucide_icon(:boxes, size: 14) %></span><strong>posts</strong></div>
                <code class="version-code"><%= focus_copy&.version %></code>
                <% if focus_copy&.pinned? %>
                  <span class="service-state state-pinned"><i></i>Pinned</span>
                <% else %>
                  <span class="service-state state-sync"><i></i>Following <%= bibe.environment %></span>
                <% end %>
              </div>
              <details class="all-services">
                <summary>Show all <%= bibe.bibes_services.size %> services</summary>
                <div class="service-list">
                  <% bibe.bibes_services.ordered.each do |bibe_service| %>
                    <div class="service-row">
                      <span class="service-name"><span class="service-glyph"><%= lucide_icon(bibe_service.service.kind == "store" ? :database : :boxes, size: 14) %></span><%= bibe_service.service.name %></span>
                      <code class="version-code"><%= bibe_service.version %></code>
                      <span class="service-state <%= bibe_service.pinned? ? 'state-pinned' : 'state-sync' %>"><i></i><%= bibe_service.pinned? ? "Pinned" : "Following #{bibe.environment}" %></span>
                    </div>
                  <% end %>
                </div>
              </details>

              <div class="bibe-card-foot">
                <span><%= bibe.bibes_services.count %> services · <%= !@cluster_ready ? "cluster unavailable" : (bibe_ready ? "all pods ready" : "pods starting") %></span>
                <a href="<%= bibe_path(bibe) %>" class="text-link">Manage BIBE <span><%= lucide_icon(:arrow_right, size: 14) %></span></a>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>

      <section class="create-section" id="create-bibe">
        <div class="create-copy">
          <div class="eyebrow">NEW ENVIRONMENT</div>
          <h2>Make room to experiment.</h2>
          <p>Pick a parent. Your services will be copied into a namespace only your BIBE uses.</p>
          <div class="create-note"><span><%= lucide_icon(:arrow_right, size: 14) %></span> Deploying a service later pins only that service.</div>
        </div>
        <%= form_with scope: :bibe, url: bibes_path, class: "create-form" do |form| %>
          <label class="field-label" for="bibe_engineer">Your name</label>
          <%= form.text_field :engineer, id: "bibe_engineer", placeholder: "e.g. Alice", required: true, autocomplete: "name" %>
          <label class="field-label" for="bibe_name">BIBE name</label>
          <%= form.text_field :name, id: "bibe_name", placeholder: "e.g. alice-feature", required: true, pattern: "[A-Za-z0-9][A-Za-z0-9 -]*", title: "Letters, numbers, spaces and hyphens" %>
          <label class="field-label" for="bibe_environment">Start from</label>
          <%= form.select :environment, @environments.map { |environment| [environment.name.capitalize, environment.name] }, {}, id: "bibe_environment" %>
          <button class="button button-primary button-full" type="submit" <%= "disabled" unless @cluster_ready %>>Create isolated environment <span>→</span></button>
          <% unless @cluster_ready %><small class="form-help">Connect Minikube to create a BIBE.</small><% end %>
        <% end %>
      </section>

      <section class="parents-section">
        <details class="parent-disclosure">
          <summary>Manage all parent releases <span><%= @environments.sum { |environment| environment.releases.size } %> services across <%= @environments.size %> environments</span></summary>
          <p class="parents-intro">A parent release updates unpinned services in its BIBEs. Pinned services keep their current version.</p>
          <div class="parent-grid">
            <% @environments.each do |environment| %>
            <article class="parent-card">
              <div class="parent-heading"><span class="parent-symbol"><%= environment.name == "prod" ? "P" : "S" %></span><div><h3><%= environment.name.capitalize %></h3><span><%= @bibes.count { |b| b.environment == environment.name } %> BIBEs from this parent</span></div><span class="parent-indicator"><i></i> PARENT</span></div>
              <div class="parent-services">
                <% environment.releases.includes(:service).sort_by { |release| release.service.name }.each do |release| %>
                  <div class="parent-service-row">
                    <span><span class="service-glyph"><%= lucide_icon(release.service.kind == "store" ? :database : :boxes, size: 14) %></span><%= release.service.name %></span>
                    <code><%= release.version %></code>
                    <details class="deploy-details">
                      <summary>Release version</summary>
                      <%= form_with url: deploy_parent_service_path(environment, release.service), method: :post, class: "inline-deploy-form" do |form| %>
                        <% unpinned_copies = BibeService.joins(:bibe).where(bibes: { environment: environment.name }, service: release.service, pinned: false).count %>
                        <small>Updates <%= pluralize(unpinned_copies, "unpinned copy") %> after release.</small>
                        <%= form.text_field :version, value: release.version, aria: { label: "New #{release.service.name} version" }, required: true %>
                        <%= form.submit "Release + sync", disabled: !@cluster_ready %>
                      <% end %>
                    </details>
                  </div>
                <% end %>
              </div>
              <div class="parent-foot">New parent versions flow to every unpinned BIBE.</div>
            </article>
            <% end %>
          </div>
        </details>
      </section>

      <footer class="page-footer"><span>Built to understand how isolated backends work.</span><span>Local only <b>·</b> Minikube <b>·</b> SQLite</span></footer>
    </div>
  </main>
</div>
