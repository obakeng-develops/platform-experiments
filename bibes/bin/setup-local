#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v minikube >/dev/null 2>&1; then
  echo "Install Minikube first: https://minikube.sigs.k8s.io/docs/start/"
  exit 1
fi

if ! minikube status --format='{{.Host}}' 2>/dev/null | grep -q Running; then
  minikube start --driver=docker --cpus=4 --memory=6144
fi

docker build -t bibes-service:latest service
minikube image load bibes-service:latest
bin/rails db:prepare
bin/rails db:seed
bin/rails runner script/demo.rb

echo
echo "Ready. Run: bin/rails server -p 3002"
echo "Then open: http://localhost:3002"
